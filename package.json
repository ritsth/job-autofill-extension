{
  "name": "job-autofill-extension",
  "private": true,
  "version": "1.1.7",
  "type": "module",
  "description": "Autofill job applications on Greenhouse, Lever & Workday and draft AI answers and tailored cover letters from your profile.",
  "license": "MIT",
  "author": "Ritika Shrestha",
  "repository": {
    "type": "git",
    "url": "https://github.com/ritsth/job-autofill-extension.git"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "package": "CRX_NO_KEY=1 npm run build && cd dist && zip -r -FS ../web-store-package.zip . -x '.DS_Store' && cd .."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
